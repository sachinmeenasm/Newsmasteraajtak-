<!DOCTYPE html>
<html lang="hi">
<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
>

<title>NEWSMASTER | News</title>

<style>

/* =========================
   RESET
========================= */

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,"Noto Sans Devanagari",sans-serif;
  background:#f4f4f4;
  color:#222;
}

a{
  text-decoration:none;
  color:inherit;
}


/* =========================
   HEADER
========================= */

header{
  background:#fff;
  position:sticky;
  top:0;
  z-index:1000;
  box-shadow:0 2px 8px #0002;
}

.header-top{
  max-width:1200px;
  margin:auto;
  min-height:75px;
  padding:12px 20px;

  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  font-size:32px;
  font-weight:900;
}

.logo span{
  color:#e31824;
}


/* =========================
   NAVIGATION
========================= */

nav{
  background:#111;
  color:white;
  overflow:auto;
  white-space:nowrap;
}

.nav-inner{
  max-width:1200px;
  margin:auto;
  display:flex;
}

nav a{
  display:block;
  color:white;
  padding:14px 20px;
  font-size:16px;
}

nav a:hover{
  background:#e31824;
}


/* =========================
   CONTAINER
========================= */

.container{
  max-width:1000px;
  margin:25px auto;
  padding:0 15px;
}


/* =========================
   ACTION BUTTONS
========================= */

.actions{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-bottom:20px;
}

.action-btn{
  border:none;
  background:#111;
  color:white;
  padding:11px 16px;
  border-radius:8px;
  font-size:15px;
  cursor:pointer;
  display:inline-block;
}

.action-btn:hover{
  background:#e31824;
}


/* =========================
   ARTICLE
========================= */

.article{
  background:#fff;
  border-radius:16px;
  overflow:hidden;
  box-shadow:0 2px 12px #0001;
}


/* =========================
   IMAGE
========================= */

.news-image{
  width:100%;
  max-height:550px;
  display:block;
  object-fit:cover;
  background:linear-gradient(
    135deg,
    #222,
    #555
  );
}

.no-image{
  width:100%;
  height:350px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:linear-gradient(
    135deg,
    #222,
    #555
  );
  color:white;
  font-size:30px;
  font-weight:bold;
}


/* =========================
   ARTICLE CONTENT
========================= */

.article-content{
  padding:30px;
}

.category{
  display:inline-block;
  color:#e31824;
  font-weight:bold;
  font-size:17px;
  margin-bottom:12px;
}

h1{
  font-size:40px;
  line-height:1.3;
  margin-bottom:15px;
}

.date{
  color:#777;
  font-size:14px;
  padding-bottom:18px;
  margin-bottom:20px;
  border-bottom:1px solid #eee;
}

.article-text{
  font-size:20px;
  line-height:1.9;
  white-space:pre-line;
}

.article-text p{
  margin-bottom:18px;
}


/* =========================
   SHARE AREA
========================= */

.share-box{
  margin-top:30px;
  padding-top:20px;
  border-top:1px solid #eee;
}

.share-box h3{
  margin-bottom:12px;
}

.share-buttons{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.share-btn{
  border:none;
  padding:10px 15px;
  border-radius:7px;
  color:white;
  cursor:pointer;
  font-size:14px;
}

.copy-btn{
  background:#333;
}

.native-share{
  background:#e31824;
}


/* =========================
   LOADING
========================= */

.loading{
  background:#fff;
  padding:45px 20px;
  text-align:center;
  border-radius:14px;
  font-size:18px;
}


/* =========================
   ERROR
========================= */

.error{
  background:#fff;
  padding:45px 20px;
  text-align:center;
  border-radius:14px;
}

.error h2{
  color:#e31824;
  margin-bottom:12px;
}

.error p{
  color:#666;
  margin-bottom:20px;
}


/* =========================
   FOOTER
========================= */

footer{
  margin-top:45px;
  background:#111;
  color:#ddd;
  text-align:center;
  padding:35px 15px;
  line-height:2;
}

footer b{
  color:#e31824;
}


/* =========================
   MOBILE
========================= */

@media(max-width:800px){

  .header-top{
    min-height:65px;
    padding:10px 12px;
  }

  .logo{
    font-size:26px;
  }

  nav a{
    padding:13px 15px;
    font-size:14px;
  }

  .container{
    margin:15px auto;
  }

  .article-content{
    padding:20px;
  }

  h1{
    font-size:28px;
  }

  .article-text{
    font-size:18px;
    line-height:1.8;
  }

  .news-image{
    max-height:400px;
  }

  .no-image{
    height:230px;
    font-size:25px;
  }

  .actions{
    gap:8px;
  }

  .action-btn{
    padding:10px 13px;
    font-size:14px;
  }

}

</style>

</head>


<body>


<!-- =========================
     HEADER
========================= -->

<header>

  <div class="header-top">

    <a
      href="index.html"
      class="logo"
    >
      <span>NEWS</span>MASTER
    </a>

  </div>


  <nav>

    <div class="nav-inner">

      <a href="index.html">
        🏠 होम
      </a>

      <a href="index.html">
        🇮🇳 भारत
      </a>

      <a href="index.html">
        🌎 दुनिया
      </a>

      <a href="index.html">
        🏛️ राजनीति
      </a>

      <a href="index.html">
        💰 बिजनेस
      </a>

      <a href="index.html">
        💻 टेक्नोलॉजी
      </a>

      <a href="index.html">
        🏏 स्पोर्ट्स
      </a>

      <a href="index.html">
        🎬 मनोरंजन
      </a>

    </div>

  </nav>

</header>


<!-- =========================
     MAIN
========================= -->

<main class="container">


  <!-- ACTION BUTTONS -->

  <div class="actions">

    <button
      class="action-btn"
      onclick="goBack()"
    >
      ← वापस
    </button>


    <a
      href="index.html"
      class="action-btn"
    >
      🏠 होम
    </a>


    <button
      class="action-btn"
      onclick="shareArticle()"
    >
      🔗 शेयर
    </button>


    <button
      class="action-btn"
      onclick="copyLink()"
    >
      📋 लिंक कॉपी
    </button>


    <button
      class="action-btn"
      onclick="printArticle()"
    >
      🖨️ प्रिंट
    </button>

  </div>


  <!-- ARTICLE -->

  <div id="articleArea">

    <div class="loading">
      📰 खबर लोड हो रही है...
    </div>

  </div>


</main>


<!-- =========================
     FOOTER
========================= -->

<footer>

  <h2>
    <b>NEWS</b>MASTER
  </h2>

  <p>
    आपकी खबर, सबसे पहले।
  </p>

  <p>
    © 2026 NEWSMASTER.
    All Rights Reserved.
  </p>

</footer>


<!-- =========================
     SUPABASE
========================= -->

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>


<script>

/* =========================
   SUPABASE
========================= */

const NEWSMASTER_URL =
"https://zdupxbndazidvwrfvrhd.supabase.co";

const NEWSMASTER_KEY =
"sb_publishable_NSWujieJHbKrNORTwJa9oQ_HJvaqZdq";

const newsClient =
supabase.createClient(
  NEWSMASTER_URL,
  NEWSMASTER_KEY
);


/* =========================
   ESCAPE HTML
========================= */

function escapeHtml(text){

  return String(text || "")

    .replace(/&/g,"&amp;")

    .replace(/</g,"&lt;")

    .replace(/>/g,"&gt;")

    .replace(/"/g,"&quot;")

    .replace(/'/g,"&#039;");

}


/* =========================
   GET NEWS ID
========================= */

const params =
new URLSearchParams(
  window.location.search
);

const newsId =
params.get("id");


/* =========================
   LOAD ARTICLE
========================= */

async function loadArticle(){

  const articleArea =
    document.getElementById(
      "articleArea"
    );


  /* ID नहीं मिला */

  if(!newsId){

    articleArea.innerHTML = `

      <div class="error">

        <h2>
          ❌ खबर नहीं मिली
        </h2>

        <p>
          इस खबर का ID उपलब्ध नहीं है।
        </p>

        <a
          href="index.html"
          class="action-btn"
        >
          🏠 होम पेज पर जाएँ
        </a>

      </div>

    `;

    return;

  }


  try{

    /* =========================
       SUPABASE NEWS
    ========================= */

    const {
      data,
      error
    } =
    await newsClient

      .from("news")

      .select("*")

      .eq(
        "id",
        newsId
      )

      .single();


    /* ERROR */

    if(error){

      console.error(
        "ARTICLE ERROR:",
        error
      );

      articleArea.innerHTML = `

        <div class="error">

          <h2>
            ❌ खबर लोड नहीं हो सकी
          </h2>

          <p>
            ${escapeHtml(error.message)}
          </p>

          <a
            href="index.html"
            class="action-btn"
          >
            🏠 वापस होम
          </a>

        </div>

      `;

      return;

    }


    /* NEWS NOT FOUND */

    if(!data){

      articleArea.innerHTML = `

        <div class="error">

          <h2>
            ❌ खबर उपलब्ध नहीं है
          </h2>

          <a
            href="index.html"
            class="action-btn"
          >
            🏠 वापस होम
          </a>

        </div>

      `;

      return;

    }


    /* =========================
       DATE
    ========================= */

    let dateText =
      "तारीख उपलब्ध नहीं है";


    if(data.created_at){

      const date =
        new Date(
          data.created_at
        );


      dateText =
        date.toLocaleString(
          "hi-IN",
          {
            dateStyle:"medium",
            timeStyle:"short"
          }
        );

    }


    /* =========================
       IMAGE
    ========================= */

    let imageHTML = "";


    if(data.image_url){

      imageHTML = `

        <img
          class="news-image"
          src="${escapeHtml(data.image_url)}"
          alt="${escapeHtml(data.title)}"
          onerror="this.style.display='none'"
        >

      `;

    }else{

      imageHTML = `

        <div class="no-image">
          NEWSMASTER
        </div>

      `;

    }


    /* =========================
       DESCRIPTION
    ========================= */

    const description =
      data.description ||
      "इस खबर की विस्तृत जानकारी उपलब्ध नहीं है।";


    /* =========================
       ARTICLE
    ========================= */

    articleArea.innerHTML = `

      <article class="article">

        ${imageHTML}


        <div class="article-content">

          <div class="category">

            🏷️
            ${escapeHtml(
              data.category || "NEWS"
            )}

          </div>


          <h1>

            ${escapeHtml(
              data.title ||
              "NEWSMASTER खबर"
            )}

          </h1>


          <div class="date">

            📰 NEWSMASTER
            &nbsp; • &nbsp;
            🕒 ${escapeHtml(dateText)}

          </div>


          <div class="article-text">

            ${escapeHtml(description)}

          </div>


          <div class="share-box">

            <h3>
              खबर शेयर करें
            </h3>


            <div class="share-buttons">

              <button
                class="share-btn native-share"
                onclick="shareArticle()"
              >
                🔗 शेयर करें
              </button>


              <button
                class="share-btn copy-btn"
                onclick="copyLink()"
              >
                📋 लिंक कॉपी करें
              </button>

            </div>

          </div>

        </div>

      </article>

    `;


    /* =========================
       PAGE TITLE
    ========================= */

    document.title =
      (
        data.title ||
        "NEWSMASTER"
      ) +
      " | NEWSMASTER";

  }catch(error){

    console.error(
      "ARTICLE LOAD ERROR:",
      error
    );


    articleArea.innerHTML = `

      <div class="error">

        <h2>
          ❌ कुछ समस्या हो गई
        </h2>

        <p>
          खबर लोड नहीं हो सकी।
        </p>

        <a
          href="index.html"
          class="action-btn"
        >
          🏠 होम पेज
        </a>

      </div>

    `;

  }

}


/* =========================
   BACK BUTTON
========================= */

function goBack(){

  if(
    document.referrer &&
    document.referrer.includes(
      window.location.hostname
    )
  ){

    history.back();

  }else{

    window.location.href =
      "index.html";

  }

}


/* =========================
   SHARE
========================= */

async function shareArticle(){

  const shareData = {

    title:
      document.title,

    text:
      "NEWSMASTER पर यह खबर पढ़ें",

    url:
      window.location.href

  };


  try{

    if(
      navigator.share
    ){

      await navigator.share(
        shareData
      );

    }else{

      await copyLink();

      alert(
        "🔗 खबर का लिंक कॉपी हो गया।"
      );

    }

  }catch(error){

    console.log(
      "Share cancelled"
    );

  }

}


/* =========================
   COPY LINK
========================= */

async function copyLink(){

  try{

    await navigator.clipboard.writeText(
      window.location.href
    );

    alert(
      "✅ खबर का लिंक कॉपी हो गया।"
    );

  }catch(error){

    prompt(
      "इस लिंक को कॉपी करें:",
      window.location.href
    );

  }

}


/* =========================
   PRINT
========================= */

function printArticle(){

  window.print();

}


/* =========================
   START
========================= */

loadArticle();

</script>


</body>
</html>
